<main
  data-actions="{{ actions }}"
  data-keymap="{{ keymap }}"
  style="
    display: flex;
    flex-direction: column;
    height: 100dvh;
    background: var(--primary-6);
    color: var(--primary-6-on);
    font-family: var(--font-sans);
    font-size: var(--font-size-0);
  "
>
  <div style="
    position: relative;
    display: grid;
    grid-template-columns: 14rem 18rem 1fr;
    flex: 1;
    min-height: 0;
  ">
  <aside aria-label="Stacks" style="
    overflow-y: auto;
    border-right: 1px solid var(--primary-7-dim);
    background: var(--primary-7);
  ">
    <header style="padding: .5rem .75rem; font-size: var(--font-size--1); color: var(--primary-7-dim); text-transform: uppercase; letter-spacing: var(--font-letter-spacing-1);">
      Stacks
    </header>
    <nav>
      <ul style="list-style: none; margin: 0; padding: 0;">
        {% for stack in stacks %}
        <li>
          <button
            type="button"
            onmousedown="fetch('/select/stack/{{ stack.id }}', {method:'POST'})"
            style="
              display: block;
              width: 100%;
              text-align: left;
              padding: .4rem .75rem;
              border: 0;
              cursor: pointer;
              font: inherit;
              {% if stack.id == selectedStackId %}
                background: var(--primary-3);
                color: var(--primary-3-on);
              {% else %}
                background: transparent;
                color: inherit;
              {% endif %}
            "
            {% if stack.id == selectedStackId %}data-init="el.scrollIntoView({block: 'nearest'})"{% endif %}
          >
            {{ stack.name }}
            <small style="display: block; color: var(--primary-7-dim); font-size: var(--font-size--2);">
              {{ stack.clips | length }} | {{ stack.sort }}
            </small>
          </button>
        </li>
        {% endfor %}
      </ul>
    </nav>
  </aside>

  <section aria-label="Clips" style="
    overflow-y: auto;
    border-right: 1px solid var(--primary-7-dim);
    background: var(--primary-6);
  ">
    <header style="padding: .5rem .75rem; font-size: var(--font-size--1); color: var(--primary-7-dim); text-transform: uppercase; letter-spacing: var(--font-letter-spacing-1);">
      Clips
    </header>
    <ul style="list-style: none; margin: 0; padding: 0;">
      {% for clip in clips %}
      <li>
        <button
          type="button"
          onmousedown="fetch('/select/clip/{{ clip.id }}', {method:'POST'})"
          style="
            display: block;
            width: 100%;
            text-align: left;
            padding: .4rem .75rem;
            border: 0;
            border-bottom: 1px solid var(--primary-7);
            cursor: pointer;
            font-family: var(--font-mono);
            font-size: var(--font-size--1);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            {% if clip.id == selectedClipId %}
              background: var(--primary-3);
              color: var(--primary-3-on);
            {% else %}
              background: transparent;
              color: inherit;
            {% endif %}
          "
          {% if clip.id == selectedClipId %}data-init="el.scrollIntoView({block: 'nearest'})"{% endif %}
        >
          {{ clip.preview | default("(empty)") }}
        </button>
      </li>
      {% endfor %}
      {% if not clips %}
      <li style="padding: .75rem; color: var(--primary-7-dim); font-size: var(--font-size--1);">
        No clips yet.
      </li>
      {% endif %}
    </ul>
  </section>

  <article aria-label="Preview" style="
    overflow: auto;
    padding: 1rem 1.25rem;
    background: var(--primary-6);
  ">
    {% if selectedClip %}
      {% if selectedClip.mime_type == "image/png" or selectedClip.mime_type == "image/jpeg" %}
        <img src="/clips/{{ selectedClip.versions[0] }}/content" alt="" style="max-width: 100%; height: auto; border-radius: var(--border-radius-1);" />
      {% else %}
        <pre style="
          margin: 0;
          font-family: var(--font-mono);
          font-size: var(--font-size-0);
          line-height: var(--font-line-height-1);
          white-space: pre-wrap;
          word-break: break-word;
        ">{{ selectedClip.body | default("") }}</pre>
      {% endif %}
      <footer style="
        margin-top: 1rem;
        padding-top: .5rem;
        border-top: 1px solid var(--primary-7-dim);
        font-size: var(--font-size--2);
        color: var(--primary-7-dim);
        font-family: var(--font-mono);
      ">
        {{ selectedClip.id }} | {{ selectedClip.mime_type }}
        {% if selectedClip.position %} | pos {{ selectedClip.position }}{% endif %}
        {% if selectedClip.versions | length > 1 %}
          | <a href="/clips/{{ selectedClip.versions[1] }}/content" target="_blank" style="color: inherit;">previous</a>
        {% endif %}
      </footer>
    {% else %}
      <p style="color: var(--primary-7-dim);">Nothing selected.</p>
    {% endif %}
  </article>

  {% if mode == "actions" %}
  <div role="dialog" aria-modal="true" aria-label="Actions"
    data-init="window.actionPanel && window.actionPanel.mount(el)"
    style="
    position: absolute;
    inset: 0;
    z-index: 1000;
    background: rgba(0,0,0,0.35);
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 0 4ch 0 0;
  ">
    <div style="
      width: min(40ch, 90%);
      max-height: 60%;
      display: flex;
      flex-direction: column;
      background: var(--primary-6);
      color: var(--primary-6-on);
      border: 1px solid var(--primary-7-dim);
      border-bottom: 0;
      border-radius: var(--border-radius-3) var(--border-radius-3) 0 0;
      box-shadow: 0 -1rem 2.5rem rgba(0,0,0,0.4);
      overflow: hidden;
    ">
      <div style="
        padding: .6rem .85rem;
        border-bottom: 1px solid var(--primary-7-dim);
      ">
        <input
          id="actions-filter"
          type="text"
          placeholder="Search..."
          spellcheck="false"
          data-init="el.focus()"
          style="
            width: 100%;
            outline: none;
            border: 0;
            background: transparent;
            color: inherit;
            font-family: var(--font-sans);
            font-size: var(--font-size--1);
            line-height: var(--font-line-height-1);
          "
        />
      </div>
      <div class="action-rows" style="
        flex: 1;
        overflow: auto;
        padding: .35rem;
      ">
        {% for row in panelActions %}
        {% if row.groupStart %}
        <div aria-hidden="true" style="
          height: 1px;
          background: var(--primary-7-dim);
          margin: .35rem .6rem;
        "></div>
        {% endif %}
        <div
          class="action-row{% if loop.first %} is-selected{% endif %}"
          data-action="{{ row.action }}"
          style="
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: .25rem .6rem;
            border-radius: var(--border-radius-1);
            cursor: pointer;
            font-size: var(--font-size--1);
          "
        >
          <span>{{ row.label }}</span>
          <span style="display: inline-flex; gap: .15rem;">
            {% for k in row.keys %}<kbd>{{ k }}</kbd>{% endfor %}
          </span>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
  {% endif %}

  {% if mode == "rename" %}
  <div role="dialog" aria-modal="true" aria-label="Rename stack" style="
    position: absolute;
    inset: 0;
    z-index: 1000;
    background: rgba(0,0,0,0.45);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 6rem;
  ">
    <div style="
      width: min(28rem, 90%);
      background: var(--primary-6);
      color: var(--primary-6-on);
      border: 1px solid var(--primary-7-dim);
      border-radius: var(--border-radius-3);
      padding: .75rem 1rem;
      box-shadow: 0 1.5rem 3rem rgba(0,0,0,0.4);
    ">
      <input
        id="rename-text"
        type="text"
        value="{{ renameInitial }}"
        spellcheck="false"
        data-init="el.focus(); el.setSelectionRange(0, el.value.length)"
        style="
          width: 100%;
          outline: none;
          border: 0;
          background: transparent;
          color: inherit;
          font-family: var(--font-sans);
          font-size: var(--font-size-1);
          line-height: var(--font-line-height-1);
          padding: .25rem 0;
        "
      />
    </div>
  </div>
  {% endif %}

  {% if mode == "compose" or mode == "edit" %}
  <div role="dialog" aria-modal="true" style="
    position: absolute;
    inset: 0;
    z-index: 1000;
    padding: 1ch;
    background: rgba(0,0,0,0.45);
    display: flex;
  ">
    <div style="
      flex: 1;
      display: flex;
      flex-direction: column;
      background: var(--primary-6);
      color: var(--primary-6-on);
      border: 1px solid var(--primary-7-dim);
      border-radius: var(--border-radius-3);
      padding: 1rem 1.25rem;
      box-shadow: 0 1.5rem 3rem rgba(0,0,0,0.4);
    ">
      <textarea
        id="compose-text"
        data-init="el.focus(); el.setSelectionRange(el.value.length, el.value.length)"
        spellcheck="false"
        placeholder="{% if mode == 'edit' %}Edit clip...{% else %}Type your clip...{% endif %}"
        style="
          flex: 1;
          width: 100%;
          resize: none;
          outline: none;
          border: 0;
          background: transparent;
          color: inherit;
          font-family: var(--font-mono);
          font-size: var(--font-size-0);
          line-height: var(--font-line-height-1);
        "
      >{% if mode == "edit" and editClip %}{{ editClip.body }}{% endif %}</textarea>
    </div>
  </div>
  {% endif %}

  </div>

  <footer aria-label="Status" style="
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: .25rem .75rem;
    background: var(--primary-7);
    border-top: 1px solid var(--primary-7-dim);
    font-size: var(--font-size--2);
    color: var(--primary-7-on);
  ">
    <span style="display: flex; gap: .5rem; align-items: center;">
      {% for a in stackActions %}
        <button
          type="button"
          onmousedown="window.actions.invoke('{{ a.action | safe }}')"
          title="{{ a.label }}"
          aria-label="{{ a.label }}"
          style="
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 1.4rem;
            height: 1.4rem;
            padding: 0;
            border: 0;
            background: transparent;
            border-radius: var(--border-radius-1);
            cursor: pointer;
            color: inherit;
          "
        ><iconify-icon icon="{{ a.icon }}" width="1em" height="1em"></iconify-icon></button>
      {% endfor %}
      <span style="font-weight: var(--font-weight-medium);">{{ modeName }}</span>
    </span>
    <span style="display: flex; gap: .25rem; align-items: center; flex-wrap: wrap; justify-content: flex-end;">
      {% for b in bindings %}
        <span
          class="binding"
          onmousedown="window.actions.invoke('{{ b.action | safe }}')"
        ><span class="binding-label">{{ b.label }}</span><span class="binding-keys">{% for k in b.keys %}<kbd>{{ k }}</kbd>{% endfor %}</span></span>
      {% endfor %}
      <span aria-hidden="true" style="
        width: 1px;
        height: 1.2em;
        margin: 0 .25rem;
        background: var(--primary-7-dim);
      "></span>
      <button
        id="theme-toggle"
        type="button"
        title="Toggle theme"
        aria-label="Toggle theme"
        onmousedown="window.toggleTheme()"
        data-init="el.querySelector('iconify-icon').setAttribute('icon', document.documentElement.classList.contains('dark') ? 'lucide:sun' : 'lucide:moon')"
        style="
          display: inline-flex;
          align-items: center;
          justify-content: center;
          width: 1.4rem;
          height: 1.4rem;
          padding: 0;
          border: 0;
          background: transparent;
          border-radius: var(--border-radius-1);
          cursor: pointer;
          color: inherit;
        "
      ><iconify-icon icon="lucide:moon" width="1em" height="1em"></iconify-icon></button>
    </span>
  </footer>

</main>
