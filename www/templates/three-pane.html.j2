<main
  data-keymap='{{ keymap | safe }}'
  style="
    display: grid;
    grid-template-columns: 14rem 18rem 1fr;
    height: 100dvh;
    background: var(--neutral-1);
    color: var(--neutral-1-on);
    font-family: var(--font-sans);
    font-size: var(--font-size-0);
  "
>
  <aside aria-label="Stacks" style="
    overflow-y: auto;
    border-right: 1px solid var(--neutral-3);
    background: var(--neutral-2);
  ">
    <header style="padding: .5rem .75rem; font-size: var(--font-size--1); color: var(--neutral-2-dim); text-transform: uppercase; letter-spacing: var(--font-letter-spacing-1);">
      Stacks
    </header>
    <nav>
      <ul style="list-style: none; margin: 0; padding: 0;">
        {% for stack in stacks %}
        <li>
          <button
            type="button"
            data-on:mousedown="@post('/select/stack/{{ stack.id }}')"
            style="
              display: block;
              width: 100%;
              text-align: left;
              padding: .4rem .75rem;
              border: 0;
              cursor: pointer;
              font: inherit;
              {% if stack.id == selectedStackId %}
                background: var(--primary-3);
                color: var(--primary-3-on);
              {% else %}
                background: transparent;
                color: inherit;
              {% endif %}
            "
            {% if stack.id == selectedStackId %}data-init="el.scrollIntoView({block: 'nearest'})"{% endif %}
          >
            {{ stack.name }}
            <small style="display: block; color: var(--neutral-2-dim); font-size: var(--font-size--2);">
              {{ stack.clips | length }} | {{ stack.sort }}
            </small>
          </button>
        </li>
        {% endfor %}
      </ul>
    </nav>
  </aside>

  <section aria-label="Clips" style="
    overflow-y: auto;
    border-right: 1px solid var(--neutral-3);
    background: var(--neutral-1);
  ">
    <header style="padding: .5rem .75rem; font-size: var(--font-size--1); color: var(--neutral-2-dim); text-transform: uppercase; letter-spacing: var(--font-letter-spacing-1);">
      Clips
    </header>
    <ul style="list-style: none; margin: 0; padding: 0;">
      {% for clip in clips %}
      <li>
        <button
          type="button"
          data-on:mousedown="@post('/select/clip/{{ clip.id }}')"
          style="
            display: block;
            width: 100%;
            text-align: left;
            padding: .4rem .75rem;
            border: 0;
            border-bottom: 1px solid var(--neutral-2);
            cursor: pointer;
            font-family: var(--font-mono);
            font-size: var(--font-size--1);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            {% if clip.id == selectedClipId %}
              background: var(--primary-3);
              color: var(--primary-3-on);
            {% else %}
              background: transparent;
              color: inherit;
            {% endif %}
          "
          {% if clip.id == selectedClipId %}data-init="el.scrollIntoView({block: 'nearest'})"{% endif %}
        >
          {{ clip.preview | default("(empty)") }}
        </button>
      </li>
      {% endfor %}
      {% if not clips %}
      <li style="padding: .75rem; color: var(--neutral-2-dim); font-size: var(--font-size--1);">
        No clips yet.
      </li>
      {% endif %}
    </ul>
  </section>

  <article aria-label="Preview" style="
    overflow: auto;
    padding: 1rem 1.25rem;
    background: var(--neutral-1);
  ">
    {% if selectedClip %}
      {% if selectedClip.mime_type == "image/png" or selectedClip.mime_type == "image/jpeg" %}
        <img src="/clips/{{ selectedClip.id }}/content" alt="" style="max-width: 100%; height: auto; border-radius: var(--border-radius-1);" />
      {% else %}
        <pre style="
          margin: 0;
          font-family: var(--font-mono);
          font-size: var(--font-size-0);
          line-height: var(--font-line-height-1);
          white-space: pre-wrap;
          word-break: break-word;
        ">{{ selectedClip.body | default("") }}</pre>
      {% endif %}
      <footer style="
        margin-top: 1rem;
        padding-top: .5rem;
        border-top: 1px solid var(--neutral-3);
        font-size: var(--font-size--2);
        color: var(--neutral-2-dim);
        font-family: var(--font-mono);
      ">
        {{ selectedClip.id }} | {{ selectedClip.mime_type }}
        {% if selectedClip.position %} | pos {{ selectedClip.position }}{% endif %}
        {% if selectedClip.previous_id %}
          | <a href="/clips/{{ selectedClip.previous_id }}/content" target="_blank" style="color: inherit;">previous</a>
        {% endif %}
      </footer>
    {% else %}
      <p style="color: var(--neutral-2-dim);">Nothing selected.</p>
    {% endif %}
  </article>

  {% if mode == "compose" or mode == "edit" %}
  <div role="dialog" aria-modal="true" style="
    position: fixed;
    inset: 0;
    z-index: 1000;
    padding: 1ch;
    background: rgba(0,0,0,0.45);
    display: flex;
  ">
    <div style="
      flex: 1;
      display: flex;
      flex-direction: column;
      background: var(--neutral-1);
      color: var(--neutral-1-on);
      border: 1px solid var(--neutral-3);
      border-radius: var(--border-radius-3);
      padding: 1rem 1.25rem;
      box-shadow: 0 1.5rem 3rem rgba(0,0,0,0.4);
    ">
      <header style="
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: .5rem;
        font-size: var(--font-size--1);
        color: var(--neutral-2-dim);
      ">
        {% if mode == "compose" %}
        <span>New clip in {{ composeStackName }}</span>
        {% else %}
        <span>Edit clip in {{ editStackName }}</span>
        {% endif %}
        <span><kbd>Cmd</kbd>+<kbd>Enter</kbd> save | <kbd>Esc</kbd> cancel</span>
      </header>
      <textarea
        id="compose-text"
        data-init="el.focus(); el.setSelectionRange(el.value.length, el.value.length)"
        spellcheck="false"
        placeholder="{% if mode == 'edit' %}Edit clip...{% else %}Type your clip...{% endif %}"
        style="
          flex: 1;
          width: 100%;
          resize: none;
          outline: none;
          border: 0;
          background: transparent;
          color: inherit;
          font-family: var(--font-mono);
          font-size: var(--font-size-0);
          line-height: var(--font-line-height-1);
        "
      >{% if mode == "edit" and editClip %}{{ editClip.body }}{% endif %}</textarea>
    </div>
  </div>
  {% endif %}
</main>
